# ============================================================
# Variables d'environnement — Getaround Analysis
# Copiez ce fichier en .env et remplissez vos valeurs
# Ne committez JAMAIS le fichier .env
# ============================================================

# AWS (optionnel — si vous stockez les données sur S3)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=eu-west-3
S3_BUCKET_NAME=your-bucket-name

# MLflow (optionnel — tracking des expériences)
MLFLOW_TRACKING_URI=https://your-mlflow-server.com
MLFLOW_EXPERIMENT_NAME=getaround-pricing
